# Person C's frontend env. Copy to client/.env.local

# Keep this true until Hour 18 — it lets the UI run off local fixtures even if
# the backend is down. It is the insurance policy (§7.5).
VITE_USE_MOCKS=false

# Leave empty to use Vite's dev proxy (recommended). Set only when the backend
# runs somewhere else, e.g. a deployed Render URL.
VITE_API_BASE=
