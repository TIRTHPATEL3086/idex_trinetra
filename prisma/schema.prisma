// SIH26237 — Crypto Decryption Provenance
// Owner: Person B. Only B runs `prisma migrate dev` — everyone else runs
// `npx prisma migrate deploy && npx prisma generate` to pick up the schema.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A protected document. The plaintext never sits on disk — only the AES blob.
model Asset {
  id             Int      @id @default(autoincrement())
  title          String
  classification String? // RESTRICTED / CONFIDENTIAL / SECRET
  mimeType       String   @default("image/png")
  cipherPath     String? // where the AES-256-GCM blob lives
  iv             Bytes? // 12 bytes
  authTag        Bytes? // 16 bytes
  originalSha    Bytes // SHA-256 of the plaintext
  assetRef       Bytes    @unique // keccak256(assetId || salt) — the on-chain handle
  sizeBytes      Int      @default(0)
  createdAt      DateTime @default(now())

  events         DecryptionEvent[]
  encapsulations AssetKeyEncapsulation[]
}

/// Who may sign in, and what they are allowed to do once they have.
///
/// The split is deliberate — it is the same separation-of-duties argument the
/// verdict bands rest on. An INVESTIGATOR cannot decrypt, so the person who
/// examines the evidence can never mint a marked copy and manufacture it. An
/// OFFICER cannot trace, so nobody investigates their own leak. Only an ADMIN
/// holds both, and an AUDITOR holds neither.
enum Role {
  ADMIN // Registry administrator — uploads, releases, investigations, audits.
  OFFICER // Clearance holder — may release a copy to themselves only.
  INVESTIGATOR // Forensic analyst — traces leaks, and cannot decrypt anything.
}



/// A person who may decrypt. The NAME NEVER GOES ON CHAIN — only `userRef`.
model User {
  id      Int     @id @default(autoincrement())
  name    String // real name -- lives in Postgres only
  userRef Bytes   @unique // keccak256(userId || salt)
  dept    String?
  email   String? @unique

  // ---- authentication. None of this ever reaches the chain either. ----
  role             Role      @default(OFFICER)
  passwordHash     String? // scrypt: <salt-hex>:<key-hex>. Null = cannot sign in.
  active           Boolean   @default(true)
  lastLoginAt      DateTime?
  securityQuestion String? // Custom security challenge question set by officer
  securityAnswer   String? // Secret exact answer (case-sensitive with spaces)

  // ---- Post-Quantum Cryptography (NIST FIPS 203 & FIPS 204) ----
  kemPublicKey     Bytes? // ML-KEM-768 public key (1184 bytes)
  dsaPublicKey     Bytes? // ML-DSA-65 public key (1952 bytes)
  encryptedPqcKeys String? // AES-256-GCM encrypted private key bundle for backup/restore
  // The same secret keys wrapped with the server master key (MASTER_KEY_HEX), so
  // the server can open a document it is releasing without knowing, or guessing,
  // the user's passphrase. Never leaves the server.
  escrowedPqcKeys  String?

  events         DecryptionEvent[]
  encapsulations AssetKeyEncapsulation[]
}

/// Per-recipient broadcast encryption key encapsulation (NIST ML-KEM-768).
model AssetKeyEncapsulation {
  id      Int   @id @default(autoincrement())
  asset   Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  assetId Int
  user    User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId  Int

  kemCiphertext      Bytes // ML-KEM-768 encapsulated key (1088 bytes)
  encryptedKey       Bytes // AES-256-GCM encrypted content key (32 bytes)
  iv                 Bytes // 12 bytes
  authTag            Bytes // 16 bytes
  allottedPassphrase String? // Passphrase allotted by Admin for this officer & document
  createdAt          DateTime @default(now())

  @@unique([assetId, userId])
  @@index([assetId])
  @@index([userId])
}

/// One decryption = one receipt = one watermarked copy. This is the register.
model DecryptionEvent {
  id        Int    @id @default(autoincrement())
  receiptId Bytes  @unique // 32 bytes — matches the on-chain key
  shortId   BigInt @unique // the 36 bits actually carried by the watermark

  asset   Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  assetId Int
  user    User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId  Int

  deviceRef   Bytes?
  deviceLabel String?

  contentSha Bytes // SHA-256 of the marked file that was released
  md5Digest  Bytes // registry fingerprint (explicit PS requirement)

  // Non-repudiation: recipient's PQC digital signature on release receipt
  decryptionSignature Bytes? // ML-DSA-65 signature (3309 bytes)
  signatureCommit     Bytes? // keccak256(decryptionSignature) anchored on chain
  signatureAlgorithm  String? @default("ML-DSA-65")

  // Perceptual hashes — the BK-tree search index. Stored as BigInt (64 bits).
  pHash BigInt
  dHash BigInt?
  aHash BigInt?

  payloadBits String // the 48 bits we embedded
  markedPath  String? // where the released copy is kept for the demo

  txHash      Bytes? // blockchain receipt — the pointer back to the chain
  blockNumber BigInt?
  chainMode   String  @default("local") // local | sepolia | off

  deltaUsed    Int
  psnrDb       Float
  // Whether the fragile (tamper-evidence) layer was embedded in this release.
  // Releases made before it existed carry only the robust layer.
  fragileLayer Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([pHash])
  @@index([dHash])
  @@index([assetId])
  @@index([userId])
  @@index([createdAt])
}

/// One /api/trace run. Kept so the demo can show investigation history.
model Investigation {
  id           Int      @id @default(autoincrement())
  uploadedSha  Bytes
  candidates   Int      @default(0)
  topReceiptId Bytes?
  confidence   Float    @default(0)
  verdict      String // ATTRIBUTED / PROBABLE / INCONCLUSIVE
  reasons      String[]
  elapsedMs    Int?
  bitsMatched  Int? // watermark bits agreeing with the identified receipt, of 48
  tamper       Json? // fragile-layer verdict and per-region findings
  lens         Json? // optical lens corrections applied to a camera/screen photo
  stamps       Json? // examiners' ML-DSA-65 signatures over each dossier's evidence digest
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

/// A copy of each file the server writes to disk: an asset's ciphertext and
/// every released (marked) copy. Hosts with ephemeral disks lose `data/` on
/// each restart; this keeps decryption, previews and tracing working after
/// one. The disk stays the fast path and is refilled from here on a miss.
model StoredFile {
  key       String   @id // "cipher/asset-12.bin", "marked/0a1b2c3d.png"
  bytes     Bytes
  createdAt DateTime @default(now())
}
