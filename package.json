{
  "name": "sih26237-provenance",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Decryption provenance: invisible DWT watermarking plus blockchain-anchored release receipts.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "nodemon server/index.js",
    "start": "node server/index.js",

    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node prisma/seed.js",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force && npm run db:seed",

    "chain:node": "hardhat node",
    "chain:compile": "hardhat compile",
    "chain:test": "hardhat test",
    "chain:deploy:local": "hardhat run scripts/deploy.cjs --network localhost",
    "chain:deploy:sepolia": "hardhat run scripts/deploy.cjs --network sepolia",

    "test:smoke": "node test/smoke.mjs",
    "attack:suite": "node test/attack-suite.js",

    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",

    "client:dev": "npm --prefix client run dev",
    "client:build": "npm --prefix client run build",

    "setup": "npm install && npm --prefix client install && npm run db:generate"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.0.2",
    "@prisma/client": "^5.22.0",
    "@ronomon/reed-solomon": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "ethers": "^6.13.4",
    "express": "^4.21.1",
    "jimp": "^0.22.12",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.13.1",
    "sharp": "^0.33.5",
    "sharp-phash": "^2.2.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "eslint": "^9.16.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.13.0",
    "hardhat": "^2.22.17",
    "nodemon": "^3.1.7",
    "prettier": "^3.4.2",
    "prettier-plugin-solidity": "^1.4.1",
    "prisma": "^5.22.0"
  }
}
