# Air-gapped field kit settings — copy to .env.offline and adjust.
# Layered over .env by `npm run offline`; secrets (MASTER_KEY_HEX, REF_SALT,
# AUTH_SECRET, WATERMARK_SEED) still come from .env.
#
# The field kit's own database. It must be on this machine: it is created,
# migrated and — the first time — seeded, and seeding wipes it.
OFFLINE_DATABASE_URL=postgresql://postgres@127.0.0.1:5432/provenance_fieldkit

# Port for the single-address app (web UI + API).
OFFLINE_PORT=4000

# Where the field kit keeps its encrypted documents and released copies,
# separate from the online deployment's data.
OFFLINE_CIPHER_DIR=./data-fieldkit/cipher
OFFLINE_MARKED_DIR=./data-fieldkit/marked
